# Django
DJANGO_SECRET_KEY=local-development-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL
POSTGRES_DB=aftermuse
POSTGRES_USER=aftermuse
POSTGRES_PASSWORD=aftermuse-local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# External metadata providers
# Legacy IMP-021 Aladin Adapter only; new keys are no longer issued.
# Leave empty for tests and development. IMP-025 will replace the live provider.
ALADIN_TTB_KEY=
KAKAO_REST_API_KEY=

# Interview LLM provider. `fake` is credential-free for local development/tests;
# select `openai`, `gemini`, or `ollama` explicitly; no paid fallback is used.
LLM_PROVIDER=fake
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=30

GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
GEMINI_TIMEOUT_SECONDS=30

# Local Ollama only. Use exactly one installed model; no automatic pull.
# Alternative installed model: gemma4:26b-a4b-it-qat
OLLAMA_MODEL=gemma4:12b-it-qat
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120
